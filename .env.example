# Project Harimau Configuration

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Threat Intelligence
# GTI_API_KEY is read by the direct fast-path client (backend/tools/gti.py);
# VT_APIKEY is read by the embedded GTI MCP server (backend/mcp/gti/server.py).
# Both are populated from the same harimau-gti-api-key secret in deployment.
GTI_API_KEY=your-virustotal-api-key
VT_APIKEY=your-virustotal-api-key

# Google Web Risk
WEBRISK_API_KEY=your-webrisk-api-key

# Shodan 
SHODAN_API_KEY=your-shodan-api-key

# Cloud SQL (LangGraph AsyncPostgresSaver + investigations table)
DATABASE_URL=postgresql://harimau:password@localhost:5432/harimau

# Logging
LOG_LEVEL=INFO
# DEBUG for full trace

# Shared Frontend-to-Backend API Key (Fail-Closed Authentication)
HARIMAU_API_KEY=your-shared-frontend-backend-secret-key

# Frontend — target for the Next.js API proxy (app/src/app/api/[...path]/route.ts)
BACKEND_URL=http://localhost:8080

# App
HUNT_ITERATIONS=3
SPECIALIST_TIMEOUT=300

# Detection Agent Integration (Phase 6 - A2A)
# BACKEND ONLY — these vars are set on the harimau-backend Cloud Run service, NOT the frontend.
# Toggle without redeploying: gcloud run services update harimau-backend --set-env-vars DETECTION_AGENT_ENABLED=true,DETECTION_AGENT_URL=https://...
# When enabled, backend forwards completed investigation reports to the detection agent via A2A after each investigation.
# DETECTION_AGENT_ENABLED=false
# DETECTION_AGENT_URL=
