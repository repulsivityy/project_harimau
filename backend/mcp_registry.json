{
    "gti": {
        "transport": "stdio",
        "command": "python3",
        "args": [
            "-m",
            "backend.mcp.gti.server"
        ]
    },
    "shodan": {
        "transport": "stdio",
        "command": "python3",
        "args": [
            "-m",
            "backend.mcp.shodan.server"
        ]
    },
    "ghidra": {
        "transport": "http",
        "url": "${GHIDRA_MCP_URL}",
        "headers": {
            "X-API-Key": "${GHIDRA_MCP_API_KEY}"
        }
    }
}